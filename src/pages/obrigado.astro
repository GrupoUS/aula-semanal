---
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";
import background from "../assets/na-mesa/authority-background.png";
import Layout from "../layouts/Layout.astro";

const product = await getEntry("products", "aula-semanal");
if (!product) throw new Error("Product aula-semanal not found");
const d = product.data;
const group = d.registration.successState?.group;
if (!group) throw new Error("Registration group invite not configured");
const [desktop, mobile] = await Promise.all([
	getImage({ src: background, width: 1920, format: "webp", quality: 80 }),
	getImage({ src: background, width: 960, format: "webp", quality: 80 }),
]);
---

<Layout
	title={d.seo.title}
	description={d.seo.description}
	noindex={true}
	whatsappMessage={d.hero.whatsapp.message}
	legalDisclaimer={d.legal.disclaimer}
>
	<section class="obrigado" aria-labelledby="obrigado-title" data-thank-you-root>
		<picture class="obrigado-background" aria-hidden="true">
			<source media="(max-width: 767px)" srcset={mobile.src} width={background.width} height={background.height} />
			<img src={desktop.src} alt="" width={background.width} height={background.height} loading="eager" fetchpriority="high" />
		</picture>
		<div class="obrigado-content">
			<h1 id="obrigado-title">
				<span data-thank-you-state="neutral">{d.hero.headline} {d.hero.highlight}</span>
				<span data-thank-you-state="confirmed" hidden>{d.registration.successTitle}</span>
			</h1>
			<div data-thank-you-state="neutral" class="obrigado-state">
				<p>{d.registration.subheadline}</p>
				<a href="/#inscricao" data-thank-you-back data-conversion-zone class="obrigado-back">{d.finalCta.primaryLabel}</a>
			</div>
			<div data-thank-you-state="confirmed" class="obrigado-state" hidden>
				<p>{d.registration.successBody}</p>
				{group.description && <p class="obrigado-next">{group.description}</p>}
				<a href={group.href} data-thank-you-cta data-conversion-zone target="_blank" rel="noopener noreferrer" class="obrigado-cta">{group.label}</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.obrigado {
		position: relative;
		isolation: isolate;
		min-height: calc(100svh - 6rem);
		display: grid;
		place-items: center;
		overflow: clip;
		background: var(--color-navy);
		padding: 5rem max(1rem, 5vw) 8rem;
	}
	.obrigado-background {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}
	.obrigado-background img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
	.obrigado-content {
		width: min(100%, 37rem);
		text-align: center;
	}
	.obrigado h1 {
		margin: 2.5rem 0 1rem;
		font: 800 clamp(2.5rem, 6vw, 4.25rem) / 1.05 var(--font-editorial);
		color: var(--color-text-primary);
	}
	.obrigado-state {
		display: grid;
		justify-items: center;
		gap: 1.5rem;
		color: var(--color-text-primary);
		font-size: clamp(1rem, 2vw, 1.25rem);
		line-height: 1.6;
	}
	.obrigado-next {
		color: var(--color-gold-light);
	}
	.obrigado-back,
	.obrigado-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.75rem 1.5rem;
		border-radius: 0.75rem;
		font-weight: 700;
		text-decoration: none;
	}
	.obrigado-back {
		border: 1px solid var(--color-gold);
		color: var(--color-gold-light);
	}
	.obrigado-cta {
		background: var(--color-whatsapp);
		color: var(--color-navy);
	}
	.obrigado-cta:hover {
		background: var(--color-whatsapp-hover);
	}
	.obrigado-back:focus-visible,
	.obrigado-cta:focus-visible {
		outline: 2px solid var(--color-gold);
		outline-offset: 3px;
	}
	.obrigado [hidden] {
		display: none;
	}
	@media (max-width: 767px) {
		.obrigado { padding-block: 4rem 8rem; }
		.obrigado-background img { object-position: 36% center; }
		.obrigado-back,
		.obrigado-cta { width: 100%; }
	}
</style>

<script>
	import { THANK_YOU_MARKER_KEY, THANK_YOU_MARKER_VALUE } from "../lib/thank-you";

	try {
		if (sessionStorage.getItem(THANK_YOU_MARKER_KEY) === THANK_YOU_MARKER_VALUE) {
			for (const el of document.querySelectorAll<HTMLElement>("[data-thank-you-state]")) {
				el.hidden = el.dataset.thankYouState !== "confirmed";
			}
			window.dispatchEvent(new Event("bottomchrome:change"));
		}
	} catch {
		// Sem storage, o HTML permanece no estado neutro.
	}
</script>
