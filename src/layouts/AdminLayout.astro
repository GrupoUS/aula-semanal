---
// Shell mínimo do painel interno — sem Header/Footer/tracking/WhatsApp da landing.
// noindex sempre; usa os tokens Navy/Gold de global.css.
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="js">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#0b2434" />
		<title>{title}</title>
		<Font cssVariable="--font-inter" />
		<link rel="icon" href="/favicon-mesa.svg" type="image/svg+xml" />
	</head>
	<body
		class="min-h-screen bg-navy font-sans text-text-primary antialiased"
	>
		<a
			href="#painel"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-gold focus:px-4 focus:py-2 focus:text-navy"
		>
			Pular para o conteúdo
		</a>
		<main id="painel" tabindex="-1" class="mx-auto w-full max-w-7xl px-6 py-10 lg:px-8">
			<slot />
		</main>
	</body>
</html>
