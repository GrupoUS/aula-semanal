---
import type { CollectionEntry } from "astro:content";
import MesaMark from "../shared/MesaMark.astro";

interface Props {
	shell: CollectionEntry<"products">["data"]["shell"];
	activeNav?: string;
}
const { shell } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<header id="site-header" class:list={["mesa-header", isHome && "mesa-header-home"]}>
	<div class="mesa-container mesa-header-inner">
		{!isHome && <a href="/" aria-label={shell.brand.homeLabel} class="mesa-home-link">
			<MesaMark brand={shell.brand} />
		</a>}
		<nav aria-label={shell.navigationLabel} class="mesa-nav">
			{shell.navigation.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
	</div>
</header>
