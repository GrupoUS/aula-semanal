---
import type { CollectionEntry } from "astro:content";

type Product = CollectionEntry<"products">["data"];
interface Props {
	shell: Product["shell"];
	legal: Product["legal"];
	whatsappMessage: string;
	disclaimer?: string;
}
const { shell, legal, disclaimer } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="mesa-footer">
	<div class="mesa-container">
		{disclaimer && <p class="mesa-footer-disclaimer">{disclaimer}</p>}
		<div class="mesa-footer-bottom">
			<p class="mesa-copyright">© {currentYear} {shell.copyright}</p>
			<div class="mesa-footer-legal">
				<a href="/termos">{legal.terms.title}</a>
				<a href="/politica-de-privacidade">{legal.privacy.title}</a>
				<button type="button" data-consent-open>{shell.cookieLabel}</button>
			</div>
		</div>
	</div>
</footer>
