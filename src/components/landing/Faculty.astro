---
import { Image, Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import background from "../../assets/na-mesa/authority-background.png";
import sacha from "../../assets/na-mesa/sacha-authority.png";
import Button from "../shared/Button.astro";

type Product = CollectionEntry<"products">["data"];
interface Props {
	faculty: Product["faculty"];
	finalCta: Product["finalCta"];
}
const { faculty, finalCta } = Astro.props;
const member = faculty.lista[0];
---

<section id="autoridade" class="mesa-authority" aria-labelledby="authority-title">
	<Image src={background} alt="" class="mesa-authority-background" width={1440} format="webp" quality={80} loading="lazy" />
	<div class="mesa-container mesa-authority-grid">
		<div class="mesa-authority-portrait">
			<Picture
				src={sacha}
				alt={member.nome}
				class="mesa-authority-image"
				formats={["avif", "webp"]}
				fallbackFormat="png"
				widths={[288, 576]}
				sizes="(min-width: 768px) 288px, 75vw"
				quality={85}
				loading="lazy"
				pictureAttributes={{ class: "block h-full w-full" }}
			/>
		</div>
		<div class="mesa-authority-copy">
			<h2 id="authority-title">{faculty.headline}</h2>
			<div class="mesa-authority-bio">
				{member.bio.split("\n\n").map((paragraph) => <p class="mesa-authority-paragraph">{paragraph.split("**").map((text, index) => index % 2 ? <strong>{text}</strong> : text)}</p>)}
			</div>
			<div class="mesa-authority-cta">
				<Button href={finalCta.primaryHref} class="mesa-button" size="md">{finalCta.primaryLabel}</Button>
			</div>
		</div>
	</div>
</section>
