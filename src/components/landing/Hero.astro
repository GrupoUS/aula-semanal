---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import desktopArtwork from "../../assets/na-mesa/hero-desktop.png";
import mobileArtwork from "../../assets/na-mesa/hero-mobile.png";
import MesaMark from "../shared/MesaMark.astro";
import RegistrationForm from "./RegistrationForm.astro";

type Product = CollectionEntry<"products">["data"];
interface Props {
	hero: Product["hero"];
	event: Product["event"];
	registration: Product["registration"];
	brand: Product["shell"]["brand"];
}
const { hero, event, registration, brand } = Astro.props;
const [desktop, mobile] = await Promise.all([
	getImage({ src: desktopArtwork, width: 1920, format: "webp", quality: 85 }),
	getImage({ src: mobileArtwork, format: "webp", quality: 90 }),
]);
---

<section class="mesa-hero" aria-labelledby="hero-title">
	<picture class="mesa-hero-picture">
		<source media="(max-width: 767px)" srcset={mobile.src} width={mobileArtwork.width} height={mobileArtwork.height} />
		<img src={desktop.src} alt={hero.portraitAlt} width={desktopArtwork.width} height={desktopArtwork.height} class="mesa-hero-image" loading="eager" fetchpriority="high" />
	</picture>
	<div class="mesa-container mesa-hero-grid">
		<MesaMark brand={brand} class="mesa-hero-mark" />
		<div class="mesa-hero-intro">
			<h1 id="hero-title">{hero.headline} <span>{hero.highlight}</span></h1>
			<p class="mesa-hero-summary">{hero.subheadline.split("**").map((text, index) => index % 2 ? <strong>{text}</strong> : text)}</p>
		</div>
		<RegistrationForm registration={registration} event={event} class="mesa-hero-form" />
	</div>
</section>
