---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import logo from "../../assets/na-mesa/logo.png";

interface Props {
	brand: CollectionEntry<"products">["data"]["shell"]["brand"];
	class?: string;
}
const { brand, class: className } = Astro.props;
---

<span class:list={["mesa-mark", className]}>
	<Image src={logo} alt={brand.name} class="mesa-mark-image" width={184} height={25} format="webp" quality={100} loading="eager" />
</span>
