# Aula Gratuita OTB — variáveis de ambiente
# Copie para `.env.local` (não commitado) ou configure no painel da Vercel.
# Runbook completo do store de leads: docs/planilha-leads.md

# === Store de leads (Google Sheets via Apps Script Web App) ===
# SERVER-ONLY. Nunca prefixar com PUBLIC_: o Vite injeta tudo que começa com
# PUBLIC_ no bundle do navegador e o segredo ficaria visível.

# URL da implantação do Web App. TEM que terminar em /exec — a URL /dev exige
# login no Google e o site recebe uma página HTML em vez de dados.
SHEETS_WEBAPP_URL=

# Segredo compartilhado. Mesmo valor da Propriedade de Script `SHARED_SECRET`,
# gerado pela função `configurar()` em scripts/apps-script/Code.gs.
SHEETS_SHARED_SECRET=

# Opcional: teto por tentativa em ms (default 6000).
SHEETS_TIMEOUT_MS=

# === Canal degradado do lead ===
# Se a planilha cair, /api/inscricao ainda entrega o contato por aqui, com
# prefixo [FALHA] na mensagem. Fortemente recomendado configurar.
LEAD_NOTIFY_WEBHOOK_URL=
LEAD_NOTIFY_WEBHOOK_SECRET=

# === Painel /admin ===
# ADMIN_USERS: usuario:hash:role separados por vírgula.
# Gere o hash com: node scripts/admin-password-hash.mjs
ADMIN_USERS=
ADMIN_SESSION_SECRET=

# === Tracking ===
# Meta Pixel do OTB (público). Vazio = Pixel desligado.
# ATENÇÃO: não reutilizar o pixel de outra landing do Grupo US.
PUBLIC_FB_PIXEL_ID=

# Google Analytics 4 — Measurement ID (G-XXXXXXX). Vazio = GA4 desligado.
PUBLIC_GA4_ID=

# Meta Conversions API (server-side). Sem token, o beacon vira no-op.
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# Override opcional do endpoint do formulário (default: /api/inscricao).
# NUNCA apontar para a URL do Apps Script — vazaria o segredo no cliente.
PUBLIC_FORM_ENDPOINT=

# === CRM NeonDash (agente Hermes) ===
# Empurra o lead para o CRM onde o Hermes trabalha. Sem o token → skip silencioso.
# Chave gerada em NeonDash → Configurações → Integrações → Entrada de leads (CRM inbound).
# SERVER-ONLY — nunca prefixar com PUBLIC_.
NEONDASH_CRM_INBOUND_TOKEN=
# Opcional: só quando o destino não for a API de produção.
# NEONDASH_CRM_INBOUND_URL=https://api.neondash.com.br/api/webhooks/crm-inbound
